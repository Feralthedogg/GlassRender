{
    "name": "glassrender-react",
    "version": "0.1.0-beta",
    "description": "React components for the GlassRender glass material renderer.",
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "README.md"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "prepack": "npm run build",
        "check": "tsc -p tsconfig.json --noEmit",
        "demo": "vite --config vite.config.js",
        "build:demo": "vite build --config vite.config.js"
    },
    "peerDependencies": {
        "glassrender": "^0.1.0-beta",
        "react": ">=18"
    },
    "devDependencies": {
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "@vitejs/plugin-react": "^5.0.0",
        "glassrender": "file:..",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "typescript": "^6.0.3",
        "vite": "^8.3.2"
    }
}
