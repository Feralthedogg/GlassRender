{
    "name": "glassrender",
    "version": "0.1.0-beta",
    "description": "Real-time refractive glass material renderer for WebGL2.",
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "README.md"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "prepack": "npm run build",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "test": "tsc -p tsconfig.build.json && node --test test/*.test.mjs",
        "test:browser": "tsc -p tsconfig.build.json && node test/browser/run.mjs",
        "bench": "tsc -p tsconfig.build.json && node bench/run.mjs",
        "demo": "tsc -p tsconfig.build.json && node examples/serve.mjs"
    },
    "devDependencies": {
        "typescript": "^6.0.3"
    }
}
