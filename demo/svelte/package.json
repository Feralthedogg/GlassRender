{
    "name": "glassrender-svelte",
    "version": "0.1.1-beta",
    "description": "Svelte components for the GlassRender glass material renderer.",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Feralthedogg/GlassRender.git",
        "directory": "demo/svelte"
    },
    "homepage": "https://github.com/Feralthedogg/GlassRender/tree/main/demo/svelte#readme",
    "bugs": "https://github.com/Feralthedogg/GlassRender/issues",
    "keywords": [
        "svelte",
        "svelte5",
        "webgl2",
        "glass",
        "refraction",
        "blur",
        "material",
        "shader",
        "renderer"
    ],
    "type": "module",
    "sideEffects": false,
    "svelte": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "svelte": "./dist/index.js",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "package": "svelte-package -i src/lib -o dist",
        "prepack": "npm run package",
        "check": "svelte-check --tsconfig ./tsconfig.json --threshold warning",
        "demo": "vite --config vite.config.js",
        "build:demo": "vite build --config vite.config.js"
    },
    "peerDependencies": {
        "glassrender": "^0.1.1-beta",
        "svelte": "^5.0.0"
    },
    "devDependencies": {
        "@sveltejs/package": "^3.0.0",
        "@sveltejs/vite-plugin-svelte": "^7.3.1",
        "glassrender": "file:../..",
        "svelte": "^5.57.1",
        "svelte-check": "^4.7.6",
        "typescript": "^6.0.3",
        "vite": "^8.3.2"
    }
}
